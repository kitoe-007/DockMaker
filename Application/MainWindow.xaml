<Window x:Class="Autoaccept_electrical_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoaccept_electrical_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Загрузка" HorizontalAlignment="Left" Margin="129,318,0,0" VerticalAlignment="Top" Height="53" Width="105" Click="Button_extract_data_from_file_Click"/>
        <Label Content="Label" HorizontalAlignment="Left" Margin="163,398,0,0" VerticalAlignment="Top" Name="lab" RenderTransformOrigin="8.625,1.288"/>
        <StackPanel Width="120" HorizontalAlignment="Left"  Background="#FF0C305D">
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right" Margin="10,15,0,0" Width="100" Height="36" Background="#FF0F3B78"
                    BorderBrush="White" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/static/images/doc_icon.png" Width="20" Height="20" OpacityMask="White"/>
                    <TextBlock Text="Документы" Margin="5,0,5,0" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right" Margin="10,15,0,0" Width="100" Height="36" Background="#FF0F3B78"
            BorderBrush="White" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/static/images/data_icon.png" Width="20" Height="20" Margin="0, 0, 18, 0"/>
                    <TextBlock Text="Данные" Margin="5,0,5,0" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right" Margin="10,15,0,0" Width="100" Height="36" Background="#FF0F3B78"
BorderBrush="White" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/static/images/set_icon.png" Width="20" Height="20" Margin="0, 0, 18, 0"/>
                    <TextBlock Text="Данные" Margin="5,0,5,0" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel RenderTransformOrigin="0.495,0.379" Margin="125,10,0,385">
            <Button Background="#FF135FD6" Height="38" Width="161" HorizontalAlignment="Right" Margin="0, 0, 10, 0">
                <TextBlock Text="Сгенерировать документ" Foreground="White" FontWeight="Bold"/>
            </Button>
        </StackPanel>
        
    </Grid>
</Window>
