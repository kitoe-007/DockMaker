<Window x:Class="Autoaccept_electrical_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoaccept_electrical_app"
        xmlns:app="clr-namespace:Autoaccept_electrical_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1100"
        MinWidth="900" MinHeight="500"
        FontFamily="Segoe UI" Background="#f7f7f9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FolderIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplateTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsView}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D2E3FC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F3F4"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#D2E3FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeDocumentIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/static/images/document-icon-tree.png"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Source" Value="/static/images/document-icon.png"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FolderIconStyle}" Text="&#xE8B7;"/>
                <Image Style="{StaticResource TreeDocumentIconStyle}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border BorderBrush="DarkGray" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая навигация -->
            <Border Grid.Column="0" Background="#FF0C305D">
                <StackPanel Margin="10,15,10,0">
                    <Button Height="36" Margin="0,0,0,15" Background="#FF0F3B78"
                            BorderBrush="White" BorderThickness="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/static/images/document-icon.png" Width="20" Height="20" OpacityMask="White"/>
                            <TextBlock Text="Документы" Margin="5,0,0,0" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Height="36" Margin="0,0,0,15" Background="#FF0F3B78"
                            BorderBrush="White" BorderThickness="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Click="MoveToStorageButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/static/images/data-icon.png" Width="24" Height="24"/>
                            <TextBlock Text="Данные" Margin="5,0,0,0" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Height="36" Background="#FF0F3B78"
                            BorderBrush="White" BorderThickness="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/static/images/settings-icon.png" Width="24" Height="24"/>
                            <TextBlock Text="Настройки" Margin="5,0,0,0" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Панель шаблонов -->
            <Border Grid.Column="1"
                    BorderBrush="#DADCE0" BorderThickness="0,0,1,0" Background="White">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Шаблоны" FontWeight="Bold" FontSize="22" Margin="0,0,0,12"/>

                    <Button Grid.Row="1" Background="#FF135FD6" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,12" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="+ Создать шаблон" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </Button>

                    <Border Grid.Row="2" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" Background="#F8F9FA">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#9AA0A6" Margin="10,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Name="SearchTemplatesTextBox"
                                     TextChanged="SearchTemplatesTextBox_TextChanged"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" Padding="0,8"
                                     Foreground="#5F6368" FontSize="13">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Поиск шаблонов" Foreground="#9AA0A6" FontSize="13" Margin="0,0,8,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="3"
                              Name="TemplatesTreeView"
                              ItemsSource="{Binding Folders}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource TemplateTreeViewItem}"
                              SelectedItemChanged="TemplatesTreeView_SelectedItemChanged"/>

                    <Button Grid.Row="4" Height="36" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Background="Transparent" BorderBrush="#DADCE0" BorderThickness="1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="#5F6368" Margin="0,0,8,0"/>
                            <TextBlock Text="Импортировать шаблон" Foreground="#5F6368" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Основная рабочая область -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель действий -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="10,10,10,8">
                    <Button Name="SaveButton" Click="SaveButton_Click"
                            Background="#fefefe" Height="40" MinWidth="108" Margin="0,0,8,0"
                            BorderBrush="#DADCE0" BorderThickness="1">
                        <TextBlock Text="Сохранить" Foreground="Gray" FontWeight="Bold"/>
                    </Button>
                    <Button Background="#FF135FD6" Height="40" MinWidth="160"
                            Click="GenerateDocButton_Click" BorderThickness="0">
                        <TextBlock Text="Сгенерировать документ" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </StackPanel>

                <!-- Параметры и предпросмотр -->
                <Grid Grid.Row="1" Name="TemplateWorkspacePanel" Visibility="Collapsed" Margin="0,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="240"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Параметры -->
                    <Border Grid.Column="0" BorderBrush="DarkGray" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="DarkGray" BorderThickness="0,0,0,1"
                                    Background="#FAFAFA" Padding="12,0">
                                <Label Content="Параметры" FontWeight="SemiBold" Padding="0,12"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,8,12,12">
                                    <Label Content="Источник данных" Padding="0,4,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Height="24" Margin="0,0,8,0"
                                                  Name="DataSourceFileComboBox"
                                                  ItemsSource="{Binding DataSourceFiles}"
                                                  DisplayMemberPath="FileName"
                                                  SelectedValuePath="FullPath"/>
                                        <Button Grid.Column="1" Width="24" Height="24"
                                                Click="ChooseFileSourceButton_Click"/>
                                    </Grid>

                                    <Label Content="Форматирование данных" Padding="0,4,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="24" Name="Numeric_up_down_cut_top" Text="0"/>
                                        <Button Grid.Column="1" Width="24" Height="24" Margin="4,0,0,0"
                                                Content="↑" Name="Numeric_top_up_button" Click="Numeric_top_up_button_Click"/>
                                        <Button Grid.Column="2" Width="24" Height="24" Margin="4,0,0,0"
                                                Content="↓" Name="Numeric_top_down_button" Click="Numeric_top_down_button_Click"/>
                                        <Label Grid.Column="3" Content="Обрезать сверху" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="24" Name="Numeric_up_down_cut_bottom" Text="0"/>
                                        <Button Grid.Column="1" Width="24" Height="24" Margin="4,0,0,0"
                                                Content="↑" Name="Numeric_bottom_up_button" Click="Numeric_bottom_up_button_Click"/>
                                        <Button Grid.Column="2" Width="24" Height="24" Margin="4,0,0,0"
                                                Content="↓" Name="Numeric_bottom_down_button" Click="Numeric_bottom_down_button_Click"/>
                                        <Label Grid.Column="3" Content="Обрезать снизу" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Label Content="Раздел" Padding="0,4,0,4"/>
                                    <TextBox Height="24" Margin="0,0,0,8" Name="SectionTextBox"/>

                                    <StackPanel Name="OjrOnlyFields">
                                        <Label Content="Должность, ФИО" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Name="PositionFioTextBox"/>
                                    </StackPanel>

                                    <StackPanel Name="ZhvOnlyFields" Visibility="Collapsed">
                                        <Label Content="Наименование объекта" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="ObjectNameTextBox" TextWrapping="Wrap"/>

                                        <Label Content="Адрес объекта" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="ObjectAddressTextBox" TextWrapping="Wrap"/>

                                        <Label Content="Строительная организация" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="OrganizationTextBox"/>

                                        <Label Content="Начат" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="StartedDateTextBox"/>

                                        <Label Content="Окончен" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="FinishedDateTextBox"/>

                                        <Label Content="Вид контроля" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="ControlTypeTextBox" Text="Визуальный"/>

                                        <Label Content="Результат контроля" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Margin="0,0,0,8" Name="ControlResultTextBox" Text="Пригоден"/>

                                        <Label Content="Подпись (ФИО)" Padding="0,4,0,4"/>
                                        <TextBox Height="24" Name="InspectorFioTextBox"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Предпросмотр -->
                    <Border Grid.Column="2" BorderBrush="DarkGray" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="DarkGray" BorderThickness="0,0,0,1"
                                    Background="#FAFAFA" Padding="12,0">
                                <Label Content="Предпросмотр" FontWeight="SemiBold" Padding="0,12"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="16,16,16,12">
                                <StackPanel Name="OjrPreviewHeader">
                                    <TextBlock Text="РАЗДЕЛ 3"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Сведения о выполнении работ в процессе строительства, реконструкции, капитального ремонта объекта"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="капитального строительства"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Name="ZhvPreviewHeader" Visibility="Collapsed">
                                    <TextBlock Text="Журнал"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="входного учета и контроля качества получаемых деталей, материалов, конструкций и оборудования"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Name="ZhvPreviewObjectName"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Name="ZhvPreviewObjectAddress"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Name="ZhvPreviewOrganization"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Name="ZhvPreviewStartedDate"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Name="ZhvPreviewFinishedDate"
                                               FontFamily="Times New Roman"
                                               FontSize="14"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="2" Name="DocDataGrid" MinRowHeight="25"
                                      AutoGenerateColumns="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="All"
                                      HeadersVisibility="Column"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
